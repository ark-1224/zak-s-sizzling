# --- Database ---
DATABASE_URL="postgresql://postgres:devpass@localhost:5432/zaks_sizzling_hub"

# --- Auth ---
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-long-random-string"
KIOSK_SESSION_SECRET="replace-with-a-long-random-string"

# --- API server ---
PORT=4000
# The web app's address. When the kiosk and the admin side have their own links, list
# both, kiosk first (online payments return customers to the first one):
# WEB_ORIGIN="https://kiosk.example.com,https://admin.example.com"
WEB_ORIGIN="http://localhost:3000"

# Rate limits (optional; these are the defaults). See apps/api/src/middleware/rateLimit.ts.
# RATE_LIMIT_LOGIN_FAILURES=10              # failed sign-ins per email from one address, per 15 minutes
# RATE_LIMIT_LOGIN_FAILURES_PER_ADDRESS=50  # failed sign-ins from one address, any email, per 15 minutes
# RATE_LIMIT_ORDERS_PER_MINUTE=30           # orders per kiosk session per minute
# RATE_LIMIT_ORDERS_PER_MINUTE_PER_ADDRESS=120  # orders from one address per minute, all sessions
# RATE_LIMIT_KIOSK_SESSIONS_PER_MINUTE=60   # new kiosk sessions from one address per minute
# RATE_LIMIT_PAYMENT_STARTS_PER_SESSION=10  # online payment starts per kiosk session, per 10 minutes
# RATE_LIMIT_PAYMENT_STARTS_PER_ADDRESS=60  # online payment starts from one address, per 10 minutes
# RATE_LIMIT_REFRESH_PER_MINUTE=60          # sign-in renewals from one address per minute

# --- Web app (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
# Separate links for customers and staff (apps/web/src/proxy.ts). Leave unset locally to
# serve both from one address. On the kiosk site: SITE_ROLE=kiosk (staff pages then show
# "page not found"); on the admin site: SITE_ROLE=admin, KIOSK_SITE_URL, and
# NEXT_PUBLIC_KIOSK_URL (read at build time) so the Kiosk QR code page points at the kiosk
# link, not the admin one.
# SITE_ROLE=""
# KIOSK_SITE_URL=""
# NEXT_PUBLIC_KIOSK_URL=""
# Receipt printer on the in-store kiosk (apps/web/src/lib/receiptPrinter.ts): the address of
# the print service running on the kiosk's Raspberry Pi. Defaults to http://127.0.0.1:4000/print.
# Only a device opened once with ?printer=1 prints.
# NEXT_PUBLIC_PRINT_SERVICE_URL=""

# --- Payments (Sprint 3 — PayMongo sandbox) ---
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# --- Nutrition lookup (admin product form) ---
# A free data.gov key for USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup).
# Without it, the "Look up nutrition" buttons say the lookup isn't set up.
USDA_API_KEY=""

# --- Database backups (worker) ---
# Nightly at 2:00 AM Manila time. Any S3-compatible bucket (Backblaze B2, Cloudflare R2,
# AWS S3); without these, backups stay on local disk (and aren't scheduled when deployed).
BACKUP_STORAGE_ENDPOINT=""        # e.g. https://s3.us-west-004.backblazeb2.com
BACKUP_STORAGE_KEY=""             # the key ID
BACKUP_STORAGE_SECRET=""          # the secret (application key)
BACKUP_STORAGE_BUCKET=""
# BACKUP_STORAGE_REGION=""        # only for providers whose region isn't in the endpoint
# PG_DUMP_PATH=""                 # pg_dump 18, if it isn't on the PATH (local only)
# For `npm run backup:restore-check` (local only):
# RESTORE_DATABASE_URL=""         # an EMPTY database whose name ends in _restore_check
# PSQL_PATH=""                    # psql, if it isn't on the PATH

# --- Email alerts (worker; optional) ---
# Read by the worker from apps/worker/.env (and the Railway worker service's variables).
# Without these, alerts wait unsent. Check them with `npm run mail:test`.
ALERT_EMAIL_TO=""                 # one or more addresses, separated by commas
# Either Resend (HTTPS; works on every Railway plan, which block SMTP below Pro).
# Without a verified domain, Resend only delivers to the address you signed up with.
RESEND_API_KEY=""                 # wins over the SMTP settings when set
# Or SMTP. Gmail: SMTP_USER is the Gmail address; SMTP_PASS is an App Password for it
# (Google Account -> Security -> 2-Step Verification -> App passwords), not the normal password.
SMTP_USER=""
SMTP_PASS=""
# ALERT_EMAIL_FROM=""             # defaults to "Zak's Sizzling Hub" <SMTP_USER>, or Resend's onboarding@resend.dev
# SMTP_HOST="smtp.gmail.com"      # defaults to Gmail; set both for another SMTP server
# SMTP_PORT=465                   # 465 = TLS; 587 = STARTTLS

NODE_ENV=development
