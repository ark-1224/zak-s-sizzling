{
  "name": "@zaks/worker",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema ../api/prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/index.js",
