{
  "name": "zaks-sizzling-hub",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema apps/api/prisma/schema.prisma",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "admin:reset-password": "npm run admin:reset-password -w apps/api",
    "test": "npm run test -w apps/api",
    "backup:now": "npm run backup:now -w apps/worker",
    "backup:restore-check": "npm run backup:restore-check -w apps/worker --",
    "low-stock:now": "npm run low-stock:now -w apps/worker",
    "mail:test": "npm run mail:test -w apps/worker",
    "low-stock:alerts": "npm run low-stock:alerts -w apps/worker"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
